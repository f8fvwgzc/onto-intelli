{
  "name": "onto-intelli",
  "version": "0.2.0",
  "description": "Client for onto-intelli: ask questions of your ontology, run actions, read traces. Zero dependencies, fetch only.",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/f8fvwgzc/onto-intelli", "directory": "sdk/typescript" },
  "keywords": ["ontology", "knowledge-graph", "llm", "agents", "observability"],
  "type": "module",
  "engines": { "node": ">=18" },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "src", "README.md"],
  "scripts": {
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts",
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  }
}
